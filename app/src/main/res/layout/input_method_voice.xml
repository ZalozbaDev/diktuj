<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FAFAFA"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/ime_language"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/ime_language" />

        <ImageButton
            android:id="@+id/ime_choose_keyboard"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ime_choose_keyboard"
            android:src="@drawable/ic_keyboard" />

        <ImageButton
            android:id="@+id/ime_open_settings"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ime_open_app_settings"
            android:src="@android:drawable/ic_menu_preferences" />

        <ImageButton
            android:id="@+id/ime_hide"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ime_hide_keyboard"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />
    </LinearLayout>

    <TextView
        android:id="@+id/ime_preview"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#F0F2F4"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:paddingHorizontal="12dp"
        android:text="@string/ime_tap_microphone"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/ime_start"
            android:layout_width="72dp"
            android:layout_height="64dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ime_start_recognition"
            android:src="@android:drawable/ic_btn_speak_now" />

        <ImageButton
            android:id="@+id/ime_stop"
            android:layout_width="72dp"
            android:layout_height="64dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ime_stop_recognition"
            android:enabled="false"
            android:src="@android:drawable/ic_media_pause" />
    </LinearLayout>
</LinearLayout>
